{
  "name": "autofillr",
  "version": "1.2.3",
  "private": true,
  "type": "module",
  "description": "Automatically fill registration forms with consistently generated random data.",
  "repository": "https://github.com/umutcanbolat/autofillr.git",
  "license": "GPL-3.0-or-later",
  "author": "umutcanbolat <hello@umutcanbolat.com>",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rimraf build dist",
    "build": "npm-run-all clean build:popup build:content",
    "build:popup": "vite build",
    "build:content": "vite build --config vite.config.content.js",
    "start": "npm-run-all clean --parallel watch:popup watch:content",
    "watch:popup": "vite build --watch",
    "watch:content": "vite build --config vite.config.content.js --watch",
    "commit": "cz",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:release": "release-it --ci",
    "ci:release:dry": "npm run ci:release -- --dry-run"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@fontsource/paytone-one": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "codice-fiscale-js": "^2.4.0",
    "personal-number-generator": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.0",
    "@release-it/bumper": "^8.0.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.1.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "release-it": "^21.0.2",
    "rimraf": "^6.1.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
